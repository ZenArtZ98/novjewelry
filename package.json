{
  "name": "nov-jewelry",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.js",
    "build:release": "node scripts/build.js --release",
    "preview": "node scripts/serve-dist.js",
    "test": "playwright test",
    "format": "prettier --write src scripts tests public/*.html public/*.css *.js *.json README.md index.html",
    "format:check": "prettier --check src scripts tests public/*.html public/*.css *.js *.json README.md index.html",
    "lint": "eslint src scripts tests *.js",
    "check": "npm run lint && npm run format:check && npm run build && npm test"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
